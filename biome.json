{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": { "actions": { "source": { "useSortedKeys": "off", "organizeImports": "on" } } },
  "files": { "includes": ["**", "!target", "!**/node_modules", "!**/*.wasm"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "json": {
    "formatter": { "trailingCommas": "none" },
    "parser": { "allowComments": false, "allowTrailingCommas": false }
  },
  "linter": { "enabled": true },
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
  "overrides": [
    {
      "includes": ["compliance/**"],
      "assist": { "actions": { "source": { "useSortedKeys": "on" } } }
    }
  ],
  "javascript": {
    "formatter": { "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always" }
  }
}
