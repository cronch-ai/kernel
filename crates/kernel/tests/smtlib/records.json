{
  "description": "Records in and out: field access, construction, width and Int-to-Float coercion; validators at paths.",
  "ask": {
    "spec": {
      "name": "Summary",
      "params": [
        {
          "name": "item",
          "type": { "Record": { "name": "String", "price": "Float", "qty": "Int" } }
        }
      ],
      "output": { "Record": { "label": "String", "total": "Float", "bulk": "Bool" } },
      "validators": [
        { "kind": "nonEmpty", "at": ["label"] },
        { "kind": "maxLength", "value": 12, "at": ["label"] },
        { "kind": "min", "value": 0, "at": ["total"] },
        { "kind": "oneOf", "values": [true], "at": ["bulk"] }
      ]
    },
    "args": { "item": { "name": "pen", "price": 1.25, "qty": 12 } }
  },
  "answer": {
    "procedure": {
      "e": "let",
      "name": "qty",
      "be": { "e": "get", "of": { "e": "var", "name": "item" }, "field": "qty" },
      "in": {
        "e": "record",
        "fields": {
          "label": {
            "e": "op",
            "op": "concat",
            "args": [
              { "e": "get", "of": { "e": "var", "name": "item" }, "field": "name" },
              { "e": "lit", "v": " x" },
              { "e": "op", "op": "str", "args": [{ "e": "var", "name": "qty" }] }
            ]
          },
          "total": {
            "e": "if",
            "cond": {
              "e": "op",
              "op": "gt",
              "args": [{ "e": "var", "name": "qty" }, { "e": "lit", "v": 0 }]
            },
            "then": {
              "e": "op",
              "op": "mul",
              "args": [
                { "e": "get", "of": { "e": "var", "name": "item" }, "field": "price" },
                { "e": "var", "name": "qty" }
              ]
            },
            "else": { "e": "lit", "v": 0 }
          },
          "bulk": {
            "e": "op",
            "op": "ge",
            "args": [{ "e": "var", "name": "qty" }, { "e": "lit", "v": 10 }]
          },
          "note": { "e": "lit", "v": "dropped: the output type doesn't declare it" }
        }
      }
    }
  },
  "inputs": [
    { "item": { "name": "pen", "price": 1.25, "qty": 12 } },
    { "item": { "name": "notebook", "price": 3.1, "qty": 1 } },
    { "item": { "name": "", "price": 0.5, "qty": -4 } },
    { "item": { "name": "stapler", "price": 9.99, "qty": 100, "colour": "red" } }
  ]
}
