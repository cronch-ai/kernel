{
  "name": "@cronch/kernel",
  "version": "0.14.0",
  "description": "The reference kernel for Pata (Proven Agents, Trusted Actions): agent harnesses whose safety can be proved",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cronch-ai/kernel.git",
    "directory": "javascript"
  },
  "homepage": "https://github.com/cronch-ai/kernel#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "pata": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./kernel.wasm": "./kernel.wasm",
    "./kernel.sha256": "./kernel.sha256",
    "./run": {
      "types": "./run.d.ts",
      "default": "./run.js"
    }
  },
  "files": [
    "cli.js",
    "index.js",
    "cbor.js",
    "index.d.ts",
    "run.js",
    "run.d.ts",
    "model.js",
    "kernel.wasm",
    "kernel.sha256",
    "examples/claude-code/*.pata",
    "examples/claude-code/*.json",
    "examples/research/*.pata",
    "examples/research/*.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "../scripts/build-wasm.sh",
    "test": "node --test",
    "prepack": "rm -rf examples && for e in claude-code research; do mkdir -p examples/$e && cp ../examples/$e/*.pata ../examples/$e/*.json examples/$e/; done",
    "clean": "npm run clean --prefix .."
  },
  "license": "Apache-2.0"
}
