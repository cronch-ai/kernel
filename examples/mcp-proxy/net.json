{
  "operations": {
    "fetch": {
      "input": { "Record": { "url": "String" } },
      "output": "String",
      "effect": true,
      "pre": {
        "e": "op",
        "op": "contains",
        "args": [
          { "e": "get", "of": { "e": "var", "name": "grant" }, "field": "netAllow" },
          { "e": "get", "of": { "e": "var", "name": "args" }, "field": "url" }
        ]
      },
      "footprint": {
        "e": "record",
        "fields": {
          "reaches": { "e": "get", "of": { "e": "var", "name": "args" }, "field": "url" }
        }
      }
    },
    "ask": {
      "input": { "Record": { "url": "String" } },
      "output": "String",
      "post": {
        "e": "op",
        "op": "contains",
        "args": [{ "e": "lit", "v": ["allow", "deny"] }, { "e": "var", "name": "result" }]
      },
      "ret": { "e": "list", "items": [] },
      "onResult": {
        "e": "if",
        "cond": {
          "e": "op",
          "op": "eq",
          "args": [{ "e": "var", "name": "result" }, { "e": "lit", "v": "allow" }]
        },
        "then": {
          "e": "record",
          "fields": {
            "netAllow": {
              "e": "op",
              "op": "append",
              "args": [
                { "e": "get", "of": { "e": "var", "name": "grant" }, "field": "netAllow" },
                { "e": "get", "of": { "e": "var", "name": "args" }, "field": "url" }
              ]
            }
          }
        },
        "else": { "e": "var", "name": "grant" }
      }
    }
  },
  "grant": { "Record": { "netAllow": { "List": "String" } } }
}
